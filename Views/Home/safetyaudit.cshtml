@{
    // ViewBag.Title = "aboutus";
    ViewBag.Title = "Safety Audit Services | Third Party, Process, Electrical & Fire Safety Audits";
    ViewBag.Keywords = "Safety Audit Services, Third Party Safety Audit, IS:14489 Compliance, Process Safety Audit, Electrical Safety Audit, Fire Safety Audit, Workplace Safety Audit, Industrial Safety Audit, Safety Compliance Services, Risk Assessment Audit, Safety Management Solutions";
    ViewBag.Description = "Ensure workplace safety and compliance with our comprehensive Safety Audit services, including Third Party Safety Audit (IS: 14489), Process Safety Audit, Electrical Safety Audit, and Fire Safety Audit. Expert solutions to identify and mitigate risks across industries.";
}

<!--About start-->
<div class="page-slider about-page">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="page-heading">
                    <h2>Safety Audit</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="main-process-safety allServeDetails section-gap">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div data-aos="fade-right" class="aos-init aos-animate">
                    <div class="process-img">
                        <img src="/images/serviceimages/hazardandoperability.jpg" alt="Safety Audit" class="img-fluid" loading="lazy" width="670" height="475">
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div data-aos="fade-left" class="aos-init aos-animate">
                    <div class="process-content specialset">
                        <h3><span>What is Safety Audit?</span></h3>
                        <p>We conduct Safety Audits for process industries across India. In our audits, we follow sound auditing techniques and applicable legal guidelines. The audit report provides a systematic critical appraisal of the effectiveness of the company/plant's safety program. Safety audits are conducted to rate an organization's total safety and health program, identify its strengths and weaknesses, show where improvements are needed, and create a process and procedure by which problems can be corrected. There are several types of audits; all with specific purpose and deliverable.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="margin-top:50px;">
            <div class="col-md-12">
                <div class="text-center">
                    <div data-aos="zoom-in" data-aos-easing="linear" data-aos-duration="800">
                        <div class="heading mb-50">
                            <h2>Why Are <span> We Doing This?</span></h2>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div data-aos="fade-up" class="aos-init aos-animate">
                    <div class="process-content specialset innerMainPara">
                        <ul>
                            <li><i class="fas fa-angle-right" style="color: #2f5185;" aria-hidden="true"></i>To discover and identify potential hazards</li>
                            <li><i class="fas fa-angle-right" style="color: #2f5185;" aria-hidden="true"></i>Check the safety of your workplace and equipment</li>
                            <li><i class="fas fa-angle-right" style="color: #2f5185;" aria-hidden="true"></i>To verify that your processes are in compliance</li>
                            <li><i class="fas fa-angle-right" style="color: #2f5185;" aria-hidden="true"></i>To verify that your employees and management are engaged in your safety programs</li>
                            <li><i class="fas fa-angle-right" style="color: #2f5185;" aria-hidden="true"></i>To determine if you are documenting your safety and health program activities properly.</li>
                            <li><i class="fas fa-angle-right" style="color: #2f5185;" aria-hidden="true"></i>To evaluate the adequacy of safety training and performance.</li>
                            <li><i class="fas fa-angle-right" style="color: #2f5185;" aria-hidden="true"></i>To meet the legal requirements.</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="allservices section-gap">
    <div class="container">
        <div class="text-center" data-aos="zoom-in" data-aos-easing="linear" data-aos-duration="1500">
            <div class="heading mb-50">
                <h2>Our <span>Safety Audit</span></h2>
            </div>
        </div>

        <div class="row" data-aos="fade-up">
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="card">
                    <h5 class="card-title">Third Party Safety Audit (IS: 14489)</h5>
                    <p class="card-text">A Third-Party Safety Audit based on IS 14489:2018 is an essential evaluation designed to ensure workplace safety, compliance with statutory regulations, and the identification of potential risks.</p>
                    <a href="@Url.Content("~/Home/thirdpartysafetyaudit")" class="arrow">
                        <i class="fas fa-long-arrow-alt-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="card">
                    <h5 class="card-title">Process Safety Audit</h5>
                    <p class="card-text">A Process Safety Audit is a systematic and comprehensive evaluation of an organization's process safety management systems.</p>
                    <a href="@Url.Content("~/Home/processsafetyaudit")" class="arrow">
                        <i class="fas fa-long-arrow-alt-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="card">
                    <h5 class="card-title">Electrical Safety Audit</h5>
                    <p class="card-text">Electrical Safety Audits are essential for evaluating and improving the safety of electrical systems within an organization. These audits help identify potential risks, ensure compliance with safety standards, and implement effective measures to prevent electrical hazards.</p>
                    <a href="@Url.Content("~/Home/electricalsafetyaudit")" class="arrow">
                        <i class="fas fa-long-arrow-alt-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-6 col-lg-3 mb-4">
                <div class="card">
                    <h5 class="card-title">Fire Safety Audit</h5>
                    <p class="card-text">A Fire Safety Audit is a comprehensive evaluation of a building or facility to assess its fire risks, safety measures, and compliance with fire safety regulations. This systematic process ensures the safety of occupants, minimizes potential hazards, and helps organizations adhere to legal standards.</p>
                    <a href="@Url.Content("~/Home/firesafetyaudit")" class="arrow">
                        <i class="fas fa-long-arrow-alt-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

