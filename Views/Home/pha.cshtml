@{
    // ViewBag.Title = "aboutus";
    ViewBag.Title = "Process Hazard Analysis (PHA) Services | HAZOP, HAZID, What-If & HAC Solutions";
    ViewBag.Keywords = "Process Hazard Analysis, PHA Services, HAZOP Study, HAZID Analysis, What-If Analysis, HAC Services, Process Safety, Risk Assessment, Safety Management, Industrial Hazard Analysis, Process Safety Audit, Process Hazard Assessment";
    ViewBag.Description = "Explore our comprehensive Process Hazard Analysis (PHA) services, including HAZOP Study, HAZID Analysis, What-If Analysis, and HAC. Ensure process safety, mitigate industrial risks, and comply with safety regulations with our expert team. Tailored solutions for industrial safety and risk management.";
}

<!--About start-->
<div class="page-slider about-page">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="page-heading">
                    <h2>Process Hazard Analysis (PHA)</h2>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="main-process-safety allServeDetails section-gap">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="process-img">
                    <img src="/images/serviceimages/hazardandoperability.jpg" alt="Process Hazard Analysis (PHA)" class="img-fluid" loading="lazy" width="670" height="475">
                </div>
            </div>
            <div class="col-md-6">
                <div class="process-content specialset">
                    <h3><span>What is PHA?</span></h3>
                    <p>Process Hazard Analysis (PHA) is an organized and methodical approach to identify, evaluate & develop methods to control process hazards. It also helps to protect against process downtime, property damage, product quality issues, and adverse publicity from accidents. JOGI has conducted more than 500 assignments in past 07 years on PHAS for a wide variety of facilities by using different PHA techniques. For betterment knowledge, we have designed in-house training programs by experts of such techniques. We are also giving On-site customized Trainings on different PHA topics.</p>
                    <h3><span>Purpose</span></h3>
                    <ul>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>For Pre-Identification and mitigation of Process Hazards and Risk</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>To check the compatibility of the process with environment and plant</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>It facilitates a full hazard analysis to increase the efficiency of plant/production</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>To comply with legal requirements</li>
                    </ul>
                    <h3><span>Methods of PHA</span></h3>
                    <ul>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>Bow-Tie Analysis (BTA)</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>Event Tree Analysis (ETA)</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>Fault Tree Analysis (FTA)</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>Failure Modes, Effects, and Criticality Analysis (FMECA)</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>Hazard and Operability Study (HAZOP)</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>Hazard Identification (HAZID)</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>Major Hazard Analysis (MHA)</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>Preliminary Hazard Analysis (PHA)</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>Process Hazard Review (PHR)</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>Quantitative Risk Assessment (QRA)</li>
                        <li><i class="fas fa-angle-right" style="color: #2f5185;"></i>What-If Analysis</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="allservices section-gap">
    <div class="container">
        <div class="text-center" data-aos="zoom-in" data-aos-easing="linear" data-aos-duration="1500">
            <div class="heading mb-50">
                <h2>Our <span> PHA Services</span></h2>
            </div>
        </div>
        <div data-aos="fade-up" class="aos-init aos-animate">
            <div class="row">
                <div class="col-md-6 col-lg-3 mb-4">
                    <div class="card">
                        <h5 class="card-title">HAZOP</h5>
                        <p class="card-text">We provide HAZOP Study Services to a wide range of industries including Oil and Gas, Petrochemical, Chemical, Fertilizer, Pharmaceutical, Pesticides, etc. We also provide HAZOP Chairman for HAZOP Study of process P & IDs at the design stage.</p>
                        <a href="@Url.Content("~/Home/hazopservice")" class="arrow">
                            <i class="fas fa-long-arrow-alt-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 mb-4">
                    <div class="card">
                        <h5 class="card-title">HAZID</h5>
                        <p class="card-text">A Hazard Identification (HAZID) Study is a proactive risk management tool that identifies possible hazards and risks early in the life cycle of a project or operation.</p>
                        <a href="@Url.Content("~/Home/hazid")" class="arrow">
                            <i class="fas fa-long-arrow-alt-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 mb-4">
                    <div class="card">
                        <h5 class="card-title">What-If Analysis</h5>
                        <p class="card-text">A What-If Analysis Study appears at hypothetical scenarios to identify potential risks and hazards in your processes or projects. This dynamic strategy mixes creativity and organization, ensuring that you're ready for "what if" scenarios before they occur.</p>
                        <a href="@Url.Content("~/Home/whatifanalysis")" class="arrow">
                            <i class="fas fa-long-arrow-alt-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 mb-4">
                    <div class="card">
                        <h5 class="card-title">HAC</h5>
                        <p class="card-text">Hazardous Area Classification (HAC) plays a vital role in identifying and mitigating risks tied to explosive environments within industrial operations.</p>
                        <a href="@Url.Content("~/Home/hac")" class="arrow">
                            <i class="fas fa-long-arrow-alt-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

