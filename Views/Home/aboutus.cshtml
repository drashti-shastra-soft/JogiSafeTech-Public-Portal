@{
    // ViewBag.Title = "aboutus";
    ViewBag.Title = "About JOGI SafeTech Pvt. Ltd. | Your Trusted Safety Partner Since 2009";
    ViewBag.Keywords = "About JOGI SafeTech, Safety Consultants Surat, Gujarat Safety Experts, Industrial Safety Services, Risk Assessment Company, Fire Safety Experts, Hygiene Services Gujarat, Established in 2009";
    ViewBag.Description = "Learn more about JOGI SafeTech Pvt. Ltd., established in 2009 and committed to delivering safety consulting and risk management expertise in Surat, Gujarat. We specialize in Process Hazard Analysis, Process Safety Management, Fire Safety, Risk Assessments, and customized safety solutions for industrial clients.";
}

<!--About start-->
<div class="page-slider about-page">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="page-heading">
                    <h2>About Us</h2>
                </div>
            </div>
        </div>
    </div>
</div>
<!--About-->
<div class="aboutpage-main">
    <div class="section-gap about-us">
        <div class="container">
            <div class="text-center mb-80">
                <div data-aos="zoom-in">
                    <div class="heading">
                        <h2 translate="no">JOGI SafeTech <span>Pvt. Ltd.</span></h2>
                    </div>
                    <div class="aboutus-text">
                        <h5 class="">Fast growing Indian based Process Safety Consultancy company.</h5>
                    </div>
                </div>
            </div>
            <div class="row safetech">
                <div class="col-md-12 col-lg-4 text-center">
                    <div data-aos="fade-right">
                        <div class="aboutpage-img">
                            <div class="hover-bg">
                                <img src="/images/aboutmain.jpg" alt="Comapny Front" class="img-fluid" loading="lazy" width="350" height="350">
                            </div>
                        </div>
                        @* <div class="about-img h-100" data-aos="zoom-in">
                        <img src="~/images/aboutmain.jpg" class="img-fluid" alt="image" />
                        </div> *@
                    </div>
                </div>
                <div class="col-md-12 col-lg-8">
                    <div data-aos="fade-left">
                        <div class="aboutus-text">
                            <p id="aboutusdetailfetch">
                                Established in 2009, JOGI SafeTech PVT. LTD. is a trusted name in safety and risk management solutions, providing comprehensive services to ensure workplace safety and regulatory compliance. With a strong commitment to safeguarding lives, property, and the environment, we specialize in Process Hazard Analysis (PHA), Hygiene Services, Process Safety Management (PSM), and Risk Assessment. Our expertise extends to essential safety services such as Material Handling, Fire Safety Services, Safety Audits, Electrical Safety Services, and additional offerings like the OEP (On-Site Emergency Plan), Safety Report (68K), and ERDMP (Emergency Response and Disaster Management Plan).
                            </p>
                            <p>Our team of seasoned professionals brings a wealth of industry experience and knowledge, enabling us to deliver tailored solutions that meet the unique requirements of each client. At JOGI SafeTech PVT. LTD., we prioritize proactive measures to reduce risk and enhance operational safety across diverse sectors. Our steadfast commitment to quality, professionalism, and client satisfaction makes us a preferred partner in the field of safety management.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--profile-->
<div class="founder-profile section-gap">
    <div class="container">
        <div class="row justify-content-center align-items-center">
            <div class="col-lg-8">
                <div data-aos="fade-right">
                    <div class="heading-owner">
                        <h2 id="FounderFetch"></h2>
                    </div>
                    <div class="founder-content">
                        <blockquote><i class="fas fa-quote-left"></i>True Safety is Achieved Not by Chance but Through Dedication, Vigilance, and an Unwavering Commitment to Protect What Matters Most—our People and Our Future.</blockquote>
                        <p>
                            At JOGI SafeTech PVT. LTD., safety is not just a service—it’s our purpose. When we founded this company in 2009, our vision was clear: to create safer work environments and ensure that every organization has access to the tools and expertise required to protect their workforce and assets. Over the years, we have built a team that shares this commitment and is passionate about making a difference in the field of safety.
                        </p>
                        <p>
                            Our dedication to quality and continuous improvement has allowed us to serve clients across various industries with trust and reliability. As we look to the future, we remain steadfast in our mission to deliver innovative and effective safety solutions. Thank you for choosing JOGI SafeTech PVT. LTD. as your partner in safety—we look forward to helping you build a safer tomorrow.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div data-aos="fade-left">
                    <div class="aboutpage-img">
                        <div class="hover-bg">
                            <img src="~/images/aboutMe.jpg" alt="Founder About" class="img-fluid" loading="lazy" width="350" height="350" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

