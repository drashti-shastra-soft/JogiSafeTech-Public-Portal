@{
    // ViewBag.Title = "aboutus";
    ViewBag.Title = "JOGI SafeTech Certifications & Accreditations | Ensuring Quality & Compliance";
    ViewBag.Keywords = "Safety Certifications, JOGI SafeTech Accreditations, Gujarat Safety Compliance, ISO Certification, Industrial Safety Standards, Safety Quality Standards, Safety Compliance Gujarat";
    ViewBag.Description = "JOGI SafeTech Pvt. Ltd. holds industry-leading certifications and accreditations that reflect our commitment to quality and compliance in safety consulting. Learn more about our certifications, ensuring adherence to the highest safety standards for Process Hazard Analysis, Fire Safety, and more.";
}

<!--About start-->
<div class="page-slider about-page">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="page-heading">
                    <h2>Certifications & Accreditations</h2>
                </div>
            </div>
        </div>
    </div>
</div>
<!--About-->
<div class="aboutpage-main">
    <div class="section-gap about-us">
        <div class="container">
            <div class="text-center mb-80">
                <div data-aos="zoom-in" data-aos-easing="linear" data-aos-duration="800">
                    <div class="heading">
                        <h2>Trusted by Industry, <span>Certified for Safety</span></h2>
                    </div>
                    <div class="aboutus-text">
                        <h5 class="">Leading the Way in Workplace Safety</h5>
                    </div>
                </div>
            </div>
            <div class="row safetech">
                <div class="col-md-12">
                    <div data-aos="fade-left" data-aos-easing="linear" data-aos-duration="800">
                        <div class="aboutus-text">
                            <p id="aboutusdetailfetch">
                                At Jogi SafeTech, we uphold the highest standards of safety and quality, ensuring our clients receive reliable, compliant services they can trust. Our certifications and accreditations reflect our commitment to excellence, rigorous standards, and adherence to best practices in the safety and compliance industry.
                            </p>
                            <p>Our team’s qualifications and our company’s accreditations provide confidence that every solution we deliver is backed by industry expertise and meets both national and international standards. We continuously update our knowledge and practices, staying at the forefront of safety and regulatory advancements to deliver unparalleled service.</p>
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
