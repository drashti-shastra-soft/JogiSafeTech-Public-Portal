    <script>
        //Same Height jQuery
        function setEqualHeight3() {
            var maxHeight = 0;

            // Reset the height first to handle resizing
            $('.customer-inner').css('height', 'auto');

            // Loop through each div to find the maximum height
            $('.customer-inner').each(function () {
                var thisHeight = $(this).outerHeight();
                if (thisHeight > maxHeight) {
                    maxHeight = thisHeight;
                }
            });

            // Set each div to the maximum height
            $('.customer-inner').css('height', maxHeight + 'px');
        }

        // Initial call to set heights
        setEqualHeight3();

        // Optional: Adjust heights on window resize for responsiveness
        $(window).resize(function () {
            setEqualHeight3();
        });
    </script>

