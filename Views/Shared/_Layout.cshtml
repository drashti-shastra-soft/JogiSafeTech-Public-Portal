    <script>
        $(document).ready(function () {
            //Loader
            $(window).on('load', function () {
                $('#lodeerloder').addClass('hidden');
            });
            setTimeout(function () {
                $('#lodeerloder').addClass('hidden');
            }, 3000);

            //Toggle Social media
            let menuToggle = document.querySelector('.menuToggle');
            menuToggle.onclick = function () {
                menuToggle.classList.toggle('active');
            }

            //Sticky Navbar
            $(window).scroll(function () {
                if ($(this).scrollTop() > 50) {
                    $('.navbar-main').addClass('fixed');
                } else {
                    $('.navbar-main').removeClass('fixed');
                }
            });

            //1st Top Bar
            let lastScrollY = window.scrollY;
            const navbar = document.querySelector('.header-top_area');

            window.addEventListener('scroll', () => {
                if (window.scrollY > lastScrollY) {
                    // Scroll down - hide navbar
                    navbar.style.display = 'none';
                } else {
                    // Scroll up - show navbar
                    navbar.style.display = 'block';
                }
                lastScrollY = window.scrollY;
            });

            //Pagination Table
            $('#clientTable').DataTable({
                pageLength: 10
            });

            var maxHeight = 0;

            // Find the tallest .box element
            $('.new-home-about').each(function () {
                var thisHeight = $(this).outerHeight();
                if (thisHeight > maxHeight) {
                    maxHeight = thisHeight;
                }
            });

            // Set all .new-home-about elements to the tallest height
            $('.new-home-about').height(maxHeight);

        });
    </script>

    <script>
        $(document).ready(function () {
            // Testimonial Same Height
            function setSameHeight() {
                let maxHeight = 0;

                // Reset height to auto for recalculation
                $('.testimonial-page').css('height', 'auto');

                // Calculate max height
                $('.testimonial-page').each(function () {
                    const currentHeight = $(this).outerHeight(); // Use outerHeight for better accuracy with padding/margins
                    if (currentHeight > maxHeight) {
                        maxHeight = currentHeight;
                    }
                });

                // Apply the max height
                $('.testimonial-page').css('height', maxHeight + 'px');
            }

            // Run on page load
            setSameHeight();

            // Recalculate on window resize
            $(window).on('resize', function () {
                setSameHeight();
            });
        });
    </script>


    <script>
